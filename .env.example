# Required for alerts
CRON_SECRET=change-me-to-a-long-random-string
TELEGRAM_BOT_TOKEN=            # from @BotFather (keep it secret, never commit it)
TELEGRAM_CHAT_ID=              # run GET /api/cron/alerts?whoami=1 after messaging your bot

# State storage: set both on Vercel (Upstash Redis). Without them a local .data/ file is used (self-host only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
ALERT_COINS=BTC,ETH,SOL,XRP,HYPE,DOGE,PEPE,BONK,WIF,TRUMP,LINK,AAVE,ENA,SUI
